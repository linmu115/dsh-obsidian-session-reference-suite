{
  "name": "dsh-obsidian-session-reference-suite",
  "version": "0.1.0",
  "description": "One DSH Bundle that composes Annotation Core, Bridge lifecycle, Obsidian reference adapter, and Sticker Board as a Cordis group.",
  "type": "module",
  "license": "MIT",
  "files": ["cordis.patch.yml", "README.md", "LICENSE"],
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "check": "pnpm test && pnpm pack --dry-run --json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshKnowledge": {
    "annotationProtocolVersion": 2,
    "bridgeLifecycleProtocolVersion": 1,
    "stickerProtocolVersion": 1
  },
  "peerDependencies": {
    "dsh-annotation-core": "*",
    "dsh-obsidian-bridge-protocol": "*",
    "dsh-obsidian-bridge-lifecycle": "*",
    "dsh-obsidian-reference-adapter": "*",
    "dsh-session-sticker-board": "*"
  },
  "peerDependenciesMeta": {
    "dsh-annotation-core": { "optional": true },
    "dsh-obsidian-bridge-protocol": { "optional": true },
    "dsh-obsidian-bridge-lifecycle": { "optional": true },
    "dsh-obsidian-reference-adapter": { "optional": true },
    "dsh-session-sticker-board": { "optional": true }
  },
  "devDependencies": {
    "dsh-annotation-core": "link:../dsh-annotation-core",
    "dsh-obsidian-bridge-protocol": "link:../dsh-obsidian-bridge-protocol",
    "dsh-obsidian-bridge-lifecycle": "link:../dsh-obsidian-bridge-lifecycle",
    "dsh-obsidian-reference-adapter": "link:../dsh-obsidian-reference-adapter",
    "dsh-session-sticker-board": "link:../dsh-session-sticker-board",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/linmu115/dsh-obsidian-session-reference-suite.git"
  }
}
